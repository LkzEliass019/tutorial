<%- console.log("USERTABLE", JSON.stringify(dados)) %>
<table width="100%">
<thead>
</tr>
<tbody>
    <tr style="border: 1px solid;">
        <th style="border: 2px solid;">ID</th>
        <th style="border: 2px solid;">Username</th>
        <th style="border: 2px solid;">Senha</th>
    </tr> 
</thead>
</tbody>
<% let i; for(i=0; i<dados.length; i++) { %>
     <% if (dados [i].username==req.session.username) {%>
                        <tr style="background-color: rgb(255, 0, 0); color: white; border: solid 1px;">
                            <%} else {%>
                        <tr style="border: 1px solid;">
                            <% }%>
  
        <td style="border: 1px solid;"><%= dados[i].id %></td>
        <td style="border: 1px solid;"><%= dados[i].username %></td>
        <td style="border: 1px solid;"><%= dados[i].password %></td>
    </tr>
    <% } %>
</tbody>
<tfoot>
    <tr>
        <th colspan="3">
         <%- `Qtde de registros ${dados.length}` %>
        </th>
      </tr>
   </tfoot>
</table>